# ExplorerIQ Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/exploreriq

# Google Cloud Vision Credentials
# Path to service account JSON key file, or configure gcloud auth application-default
GOOGLE_APPLICATION_CREDENTIALS=./config/google-vision-key.json

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173
